---
import { route, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const copy = {
  pt: {
    lede: 'Gabriel Maciel é desenvolvedor de software em Belo Horizonte/MG, com foco em backend. Programa desde 2023 e atualmente constrói sistemas corporativos, APIs, integrações, automações e produtos SaaS com C#, .NET, PHP, Laravel, Python, Node.js, TypeScript, React e PostgreSQL, com infraestrutura Docker e Linux.',
    now: 'Atualmente é desenvolvedor full stack no Grupo Roma Brasil e criador do ZapBebidas e do AgendeCorte.',
    drag: 'Arraste o globo para girar',
    touch: 'Toque no globo e arraste para girar',
    scroll: 'Role para continuar',
    coords: '19,92° S, 43,94° O',
    canvasLabel: 'Globo 3D feito de partículas, com Belo Horizonte marcada e arcos saindo dela para outras cidades do mundo.',
  },
  en: {
    lede: 'Gabriel Maciel is a backend-focused software developer in Belo Horizonte, Brazil. He has been programming since 2023 and currently builds enterprise systems, APIs, integrations, automations and SaaS products with C#, .NET, PHP, Laravel, Python, Node.js, TypeScript, React and PostgreSQL, running on Docker and Linux.',
    now: 'He is currently a full stack developer at Grupo Roma Brasil and the creator of ZapBebidas and AgendeCorte.',
    drag: 'Drag the globe to spin it',
    touch: 'Tap the globe and drag to spin it',
    scroll: 'Scroll to continue',
    coords: '19.92° S, 43.94° W',
    canvasLabel: '3D globe made of particles, with Belo Horizonte marked and arcs leaving it toward other cities around the world.',
  },
}[locale];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <canvas class="world" data-world aria-hidden="true"></canvas>
  <p class="visually-hidden">{copy.canvasLabel}</p>

  <div class="bh-label" data-bh-label aria-hidden="true">
    <strong>Belo Horizonte</strong>
    <span>{copy.coords}</span>
  </div>

  <div class="wrap hero-inner">
    <h1 id="hero-title" class="hero-title" data-hero-title>
      <span>Gabriel</span>
      <span>Maciel</span>
    </h1>
    <div class="hero-intro" data-hero-fade>
      <p class="lede">{copy.lede}</p>
      <p class="now">{copy.now}</p>
      <div class="cta">
        <a class="btn btn-primary" href={route('projects', locale)}>{t.seeProjects}</a>
        <a class="btn" href="#contato">{t.contactCta}</a>
      </div>
    </div>
  </div>

  <div class="wrap hero-foot" data-hero-fade>
    <p class="drag-hint" data-drag-hint hidden>{copy.drag}</p>
    <p class="touch-hint" data-touch-hint hidden>{copy.touch}</p>
    <a class="scroll-cue" href="#about-title">
      <span>{copy.scroll}</span>
      <span class="cue-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.querySelector<HTMLCanvasElement>('[data-world]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;

  function hasWebGL() {
    try {
      return !!document.createElement('canvas').getContext('webgl2');
    } catch {
      return false;
    }
  }

  // Abertura: o nome sobe letra por letra enquanto as partículas formam o globo.
  if (!reduced) {
    gsap.registerPlugin(SplitText);
    const title = document.querySelector<HTMLElement>('[data-hero-title]')!;
    const split = SplitText.create(title, { type: 'chars', mask: 'chars' });
    gsap.from(split.chars, { yPercent: 115, duration: 1.2, ease: 'expo.out', stagger: 0.04, delay: 0.1 });
    gsap.from('[data-hero-fade]', { opacity: 0, y: 18, duration: 1, ease: 'power3.out', stagger: 0.18, delay: 0.6 });
  }

  if (hasWebGL()) {
    const start = () =>
      import('../scripts/world').then(({ mountWorld }) => {
        mountWorld({ canvas, hero, label: document.querySelector<HTMLElement>('[data-bh-label]') });
        const fine = matchMedia('(pointer: fine)').matches;
        document.querySelector<HTMLElement>(fine ? '[data-drag-hint]' : '[data-touch-hint]')!.hidden = false;
      });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 500 });
    else setTimeout(start, 150);
  } else {
    canvas.remove();
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: calc(100svh - 5rem);
    padding-top: clamp(1.5rem, 1rem + 3vw, 4rem);
    touch-action: pan-y;
  }

  @media (pointer: fine) {
    .hero {
      cursor: grab;
    }
    .hero:global(.is-dragging) {
      cursor: grabbing;
    }
    .hero a,
    .hero button {
      cursor: pointer;
    }
  }

  /* O canvas fica fixo atrás da página inteira; as formas mudam com a rolagem. */
  .world {
    position: fixed;
    inset: 0 auto auto 0;
    width: 100vw;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s;
  }

  .world:global(.is-live) {
    opacity: 1;
  }

  /* Sem animação: o globo fica parado só no topo. */
  @media (prefers-reduced-motion: reduce) {
    .world {
      position: absolute;
      height: 100%;
    }
  }

  .bh-label {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 1;
    display: grid;
    gap: 0.1rem;
    margin-left: 1rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
    white-space: nowrap;
  }

  .bh-label strong {
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .bh-label span {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--ink-soft);
  }

  .hero-inner {
    display: grid;
    align-content: center;
    gap: 2rem;
    padding-block: 2rem 4rem;
  }

  .hero-title {
    /* Em tela baixa (celular deitado) o nome não pode ocupar a tela inteira. */
    font-size: min(var(--step-display), 24svh);
    font-stretch: 75%;
    font-weight: 780;
    letter-spacing: -0.035em;
    line-height: 0.84;
  }

  .hero-title span {
    display: block;
  }

  .hero-title span:last-child {
    padding-left: 0.42em;
  }

  .hero-intro {
    max-width: 36rem;
  }

  .now {
    margin-top: 0.75rem;
    color: var(--ink-soft);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .hero-foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .drag-hint,
  .touch-hint {
    margin-left: auto;
    order: 2;
  }

  .touch-hint {
    max-width: 9rem;
    text-align: right;
    animation: hint-pulse 2.4s ease-in-out infinite;
  }

  @keyframes hint-pulse {
    50% {
      color: var(--signal-text);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .touch-hint {
      animation: none;
    }
  }

  .scroll-cue {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .scroll-cue:hover {
    color: var(--ink);
  }

  .cue-line {
    position: relative;
    width: 3.5rem;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--signal);
    translate: -100% 0;
    animation: cue 2.2s var(--ease-out) infinite;
  }

  @keyframes cue {
    60%,
    100% {
      translate: 100% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue-line::after {
      animation: none;
      translate: 0 0;
    }
  }

  @media (max-width: 56rem) {
    .hero {
      min-height: calc(100svh - 4rem);
    }
    .hero-inner {
      align-content: start;
      padding-top: 0.5rem;
    }
    /* Esfumado sem bordas atrás do texto: o globo some aos poucos em vez de cortar. */
    .hero-inner {
      position: relative;
    }
    .hero-inner::before {
      content: '';
      position: absolute;
      inset: -2rem -1rem -3rem;
      z-index: -1;
      background: radial-gradient(120% 75% at 30% 45%, var(--bg) 35%, color-mix(in oklab, var(--bg) 70%, transparent) 60%, transparent 85%);
      pointer-events: none;
    }
    .bh-label {
      display: none;
    }
  }
</style>
