---
import { route, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  alternate: string;
  current?: 'home' | 'projects' | 'books';
}

const { locale, alternate, current } = Astro.props;
const t = ui[locale];
const links = [
  { key: 'home', href: route('home', locale), label: t.nav.home },
  { key: 'projects', href: route('projects', locale), label: t.nav.projects },
  { key: 'books', href: route('books', locale), label: t.nav.books },
] as const;
const clockLabel = locale === 'pt' ? 'Horário em Belo Horizonte' : 'Time in Belo Horizonte';
---

<header class="site-header" data-header>
  <div class="bar">
    <a class="mark" href={route('home', locale)} aria-label="Gabriel Maciel, início">
      <span class="mark-dot" aria-hidden="true"></span>
      <span class="mark-name">gabriel maciel</span>
    </a>

    <nav aria-label={t.navLabel}>
      <div class="track" data-nav>
        <span class="indicator" data-indicator aria-hidden="true"></span>
        <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        </ul>
      </div>
    </nav>

    <p class="clock">
      <span class="live" aria-hidden="true"></span>
      <span class="clock-city" aria-hidden="true">BH</span>
      <span class="visually-hidden">{clockLabel}:</span>
      <time data-header-clock data-locale={locale === 'pt' ? 'pt-BR' : 'en-GB'}>--:--:--</time>
    </p>

    <div class="tools">
      <button class="tool term-btn" type="button" data-open-terminal title={locale === 'pt' ? 'Terminal (tecla ` ou Ctrl+K)' : 'Terminal (` key or Ctrl+K)'}>
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="m5 7 5 5-5 5M12 17h7"></path>
        </svg>
        <span class="visually-hidden">{locale === 'pt' ? 'Abrir terminal' : 'Open terminal'}</span>
      </button>
      <a class="tool lang" href={alternate} hreflang={locale === 'pt' ? 'en' : 'pt-BR'} lang={locale === 'pt' ? 'en' : 'pt-BR'}>
        <span aria-hidden="true">{t.langShort}</span>
        <span class="visually-hidden">{t.langSwitch}</span>
      </a>
      <button class="tool theme-toggle" type="button" data-theme-toggle>
        <svg class="when-light" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg class="when-dark" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
        </svg>
        <span class="visually-hidden when-light">{t.theme.toDark}</span>
        <span class="visually-hidden when-dark">{t.theme.toLight}</span>
      </button>
    </div>
  </div>
</header>

<script>
  // Relógio de BH com segundos.
  const clock = document.querySelector<HTMLTimeElement>('[data-header-clock]');
  if (clock) {
    const fmt = new Intl.DateTimeFormat(clock.dataset.locale, {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      timeZone: 'America/Sao_Paulo',
    });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 1000);
  }

  // Destaque que desliza até o link sob o mouse e volta para a página atual.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const indicator = document.querySelector<HTMLElement>('[data-indicator]');
  if (nav && indicator) {
    const current = nav.querySelector<HTMLElement>('a[aria-current="page"]');
    const moveTo = (el: HTMLElement | null, instant = false) => {
      if (!el) {
        indicator.style.opacity = '0';
        return;
      }
      if (instant) indicator.style.transition = 'none';
      indicator.style.opacity = '1';
      indicator.style.width = `${el.offsetWidth}px`;
      indicator.style.transform = `translateX(${el.offsetLeft}px)`;
      if (instant) requestAnimationFrame(() => (indicator.style.transition = ''));
    };
    moveTo(current, true);
    nav.querySelectorAll<HTMLElement>('a').forEach((a) => {
      a.addEventListener('pointerenter', () => moveTo(a));
      a.addEventListener('focus', () => moveTo(a));
    });
    nav.addEventListener('pointerleave', () => moveTo(current));
    nav.addEventListener('focusout', () => moveTo(current));
    addEventListener('resize', () => moveTo(current, true));
    document.fonts?.ready.then(() => moveTo(current, true));
  }

  // Ao rolar, a barra fica mais sólida.
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-scrolled', scrollY > 24);
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 0.75rem var(--gutter) 0;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: var(--max);
    min-height: 3.6rem;
    margin-inline: auto;
    padding: 0.35rem 0.4rem 0.35rem 1.1rem;
    border: 1px solid color-mix(in oklab, var(--line) 80%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--bg) 62%, transparent);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    transition: background-color 0.3s, box-shadow 0.3s, border-color 0.3s;
  }

  .site-header:global(.is-scrolled) .bar {
    background: color-mix(in oklab, var(--bg) 86%, transparent);
    border-color: var(--line);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.55);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    font-weight: 700;
    font-stretch: 85%;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-right: auto;
  }

  .mark-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-wash);
  }

  .track {
    position: relative;
  }

  nav ul {
    position: relative;
    display: flex;
    gap: 0.15rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .indicator {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    border-radius: 999px;
    background: var(--signal-wash);
    opacity: 0;
    transition:
      transform 0.45s var(--ease-out),
      width 0.45s var(--ease-out),
      opacity 0.25s;
  }

  nav a {
    position: relative;
    display: block;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-soft);
    font-weight: 550;
    transition: color 0.2s;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }

  /* Sem JS o destaque fica no próprio link da página atual. */
  .track:not(:has(.indicator[style])) a[aria-current='page'] {
    background: var(--signal-wash);
  }

  .clock {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.85rem;
    margin-left: 0.25rem;
    border-left: 1px solid var(--line);
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .clock-city {
    color: var(--ink-soft);
    font-weight: 600;
  }

  .clock time {
    font-weight: 650;
    min-width: 4.6em;
  }

  .live {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--signal);
    animation: live 2s ease-in-out infinite;
  }

  @keyframes live {
    50% {
      box-shadow: 0 0 0 5px var(--signal-wash);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live {
      animation: none;
    }
    .indicator {
      transition: none;
    }
  }

  .tools {
    display: flex;
    gap: 0.3rem;
  }

  .tool {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    text-decoration: none;
    font-weight: 650;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .tool:hover {
    border-color: var(--line-strong);
  }

  .tool svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* O ícone mostra o tema atual; o texto acessível descreve a ação. */
  .when-dark {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not(:has(meta[name='color-scheme'][content='light']))) .when-light {
      display: none;
    }
    :global(:root:not(:has(meta[name='color-scheme'][content='light']))) .when-dark {
      display: block;
    }
  }

  :global(:root:has(meta[name='color-scheme'][content='dark'])) .when-light {
    display: none;
  }
  :global(:root:has(meta[name='color-scheme'][content='dark'])) .when-dark {
    display: block;
  }

  .when-dark.visually-hidden,
  .when-light.visually-hidden {
    position: absolute;
  }

  @media (max-width: 52rem) {
    .clock {
      padding-inline: 0.6rem;
      margin-left: 0;
    }
    .clock-city {
      display: none;
    }
  }

  /* Celular: o nome vira só o ponto e o relógio dá lugar aos links. */
  @media (max-width: 40rem) {
    .term-btn {
      display: none;
    }
    .site-header {
      padding-top: 0.5rem;
    }
    .bar {
      gap: 0.2rem;
      padding-left: 0.6rem;
    }
    .mark-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .mark {
      min-width: 1.75rem;
    }
    nav a {
      padding: 0.5rem 0.55rem;
      font-size: 0.95rem;
    }
    .clock {
      display: none;
    }
  }

  /* Telas bem estreitas: o link "Início" já leva para a home, então o ponto sai. */
  @media (max-width: 22.5rem) {
    .mark {
      display: none;
    }
    .bar {
      padding-left: 0.3rem;
    }
    nav {
      margin-right: auto;
    }
    nav a {
      padding-inline: 0.5rem;
      font-size: 0.9rem;
    }
    .tools {
      gap: 0.15rem;
    }
  }
</style>
