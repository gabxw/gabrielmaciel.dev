---
import Base from '../layouts/Base.astro';
import BookList from '../components/BookList.astro';
import { books, statusLabel, type BookStatus } from '../data/books';
import { contact, route, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  pt: {
    title: 'Livros',
    meta: 'O que Gabriel Maciel está lendo, já leu e quer ler.',
    intro: 'O que já li e o que estou lendo agora, de engenharia de software a literatura.',
    statusLabel: 'Situação',
    topicLabel: 'Tema',
    all: 'Todos',
    count: (n: number) => (n === 1 ? '1 livro' : `${n} livros`),
    none: 'Nenhum livro com esses filtros. Troque a situação ou o tema.',
    emptyTitle: 'A estante ainda está sendo montada.',
    emptyText: 'Tem um livro que mudou como você programa? Me manda a indicação.',
    emptyCta: 'Indicar um livro',
    subject: 'Indicação de livro',
  },
  en: {
    title: 'Books',
    meta: 'What Gabriel Maciel is reading, has read and wants to read.',
    intro: "What I've read and what I'm reading now, from software engineering to literature.",
    statusLabel: 'Status',
    topicLabel: 'Topic',
    all: 'All',
    count: (n: number) => (n === 1 ? '1 book' : `${n} books`),
    none: 'No books match these filters. Change the status or the topic.',
    emptyTitle: 'The shelf is still being put together.',
    emptyText: 'Is there a book that changed how you write code? Send me the recommendation.',
    emptyCta: 'Recommend a book',
    subject: 'Book recommendation',
  },
}[locale];

const statuses: BookStatus[] = ['reading', 'read', 'want'];
const counts = Object.fromEntries(statuses.map((s) => [s, books.filter((b) => b.status === s).length]));
const topics = [...new Map(books.map((b) => [b.topic.en, b.topic])).values()];
const status = statuses.filter((s) => counts[s] > 0);
---

<Base locale={locale} title={`${copy.title} | Gabriel Maciel`} description={copy.meta} alternate={route('books', locale === 'pt' ? 'en' : 'pt')} current="books">
  <div class="wrap page">
    <header class="page-head">
      <h1 class="page-title" data-reveal="title">{copy.title}</h1>
      <p class="lede" data-reveal="fade">{copy.intro}</p>
    </header>

    {
      books.length > 0 ? (
        <>
          <div class="shelf">
          <aside class="filters" data-book-filters hidden>
            <div class="filter-group" role="group" aria-label={copy.statusLabel} data-key="status">
              <span class="filter-name" aria-hidden="true">{copy.statusLabel}</span>
              <button type="button" data-filter="all" aria-pressed="true">
                {copy.all} <span class="count">{books.length}</span>
              </button>
              {status.map((s) => (
                <button type="button" data-filter={s} aria-pressed="false">
                  {statusLabel[s][locale]} <span class="count">{counts[s]}</span>
                </button>
              ))}
            </div>
            <div class="filter-group" role="group" aria-label={copy.topicLabel} data-key="topic">
              <span class="filter-name" aria-hidden="true">{copy.topicLabel}</span>
              <button type="button" data-filter="all" aria-pressed="true">
                {copy.all} <span class="count">{books.length}</span>
              </button>
              {topics.map((t) => (
                <button type="button" data-filter={t.en} aria-pressed="false">
                  {t[locale]} <span class="count">{books.filter((b) => b.topic.en === t.en).length}</span>
                </button>
              ))}
            </div>
          </aside>
          <div class="shelf-main">
          <p class="visually-hidden" role="status" data-book-status data-one={copy.count(1)} data-many={copy.count(2)} />
          <div data-book-list>
            <BookList books={books} locale={locale} />
          </div>
          <p class="none" data-books-empty hidden>{copy.none}</p>
          </div>
          </div>
        </>
      ) : (
        <div class="empty">
          <p class="empty-title">{copy.emptyTitle}</p>
          <p>{copy.emptyText}</p>
          <a class="btn btn-primary" href={`mailto:${contact.email}?subject=${encodeURIComponent(copy.subject)}`}>
            {copy.emptyCta}
          </a>
        </div>
      )
    }
  </div>
</Base>

<script>
  // Os dois grupos de filtro se combinam: situação e tema.
  const filters = document.querySelector<HTMLElement>('[data-book-filters]');
  if (filters) {
    filters.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>('[data-book-list] .book')];
    const status = document.querySelector<HTMLElement>('[data-book-status]');
    const active: Record<string, string> = { status: 'all', topic: 'all' };

    filters.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const group = button.closest<HTMLElement>('[data-key]')!;
      active[group.dataset.key!] = button.dataset.filter!;
      group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));

      let shown = 0;
      items.forEach((item) => {
        const match =
          (active.status === 'all' || item.dataset.status === active.status) &&
          (active.topic === 'all' || item.dataset.topic === active.topic);
        item.hidden = !match;
        if (match) shown++;
      });
      document.querySelector<HTMLElement>('[data-books-empty]')!.hidden = shown > 0;
      if (status) status.textContent = (shown === 1 ? status.dataset.one! : status.dataset.many!).replace('2', String(shown));
    });
  }
</script>

<style>
  .page {
    padding-top: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
  }

  .page-title {
    font-size: clamp(3.4rem, 1rem + 9vw, 8.5rem);
    font-stretch: 75%;
    font-weight: 780;
    letter-spacing: -0.035em;
    line-height: 0.86;
  }

  .shelf {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: 2.5rem 3rem;
    align-items: start;
    margin-top: 3rem;
  }

  /* Sem JS os filtros ficam escondidos e a estante ocupa a largura toda. */
  .shelf:has(.filters[hidden]) {
    grid-template-columns: 1fr;
  }

  .filters {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.75rem;
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .filter-group {
    display: grid;
    gap: 0.15rem;
  }

  .filter-name {
    margin-bottom: 0.4rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .filters button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.75rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--ink-soft);
    font-weight: 550;
    text-align: left;
    cursor: pointer;
  }

  .filters button:hover {
    color: var(--ink);
    background: color-mix(in oklab, var(--line) 45%, transparent);
  }

  .filters button[aria-pressed='true'] {
    color: var(--ink);
    background: var(--signal-wash);
    font-weight: 700;
  }

  .count {
    font-weight: 400;
    opacity: 0.7;
  }

  :global(.book[hidden]) {
    display: none;
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    margin-top: 3.5rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px dashed var(--line-strong);
    border-radius: 24px;
    max-width: 44rem;
  }

  .empty-title {
    font-size: var(--step-2);
    font-weight: 700;
    font-stretch: 85%;
  }

  .empty p:not(.empty-title) {
    color: var(--ink-soft);
    margin-bottom: 0.75rem;
  }

  @media (max-width: 56rem) {
    .page-head,
    .shelf {
      grid-template-columns: 1fr;
    }
    .filters {
      position: static;
      gap: 1rem;
      padding: 1rem;
    }
    .filter-group {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem;
    }
    .filter-name {
      width: 100%;
      margin-bottom: 0;
    }
    .filters button {
      border: 1px solid var(--line);
      border-radius: 999px;
    }
  }
</style>
