---
import Base from '../layouts/Base.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { projects, kindLabel } from '../data/projects';
import { formatMonth, projectRoute, route, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = {
  pt: {
    title: 'Projetos',
    meta: 'Projetos de Gabriel Maciel: motor de workflows em .NET, SaaS no ar e apps full stack.',
    intro: 'Do motor de workflows que eu uso para estudar falhas aos produtos que estão no ar com cliente usando. Cada um tem uma página com o porquê e o como.',
    filterLabel: 'Filtrar projetos',
    all: 'Todos',
    live: 'No ar',
    empty: 'Nenhum projeto nesse filtro. Escolha "Todos" para ver a lista completa.',
  },
  en: {
    title: 'Projects',
    meta: 'Projects by Gabriel Maciel: a .NET workflow engine, live SaaS products and full stack apps.',
    intro: 'From the workflow engine I use to study failures to the products that are live with real customers. Each one has a page with the why and the how.',
    filterLabel: 'Filter projects',
    all: 'All',
    live: 'Live',
    empty: 'No projects match this filter. Choose "All" to see the full list.',
  },
}[locale];

const sorted = [...projects].sort((a, b) => b.start.localeCompare(a.start));
const filters = [
  { id: 'all', label: copy.all, count: projects.length },
  { id: 'backend', label: kindLabel.backend[locale], count: projects.filter((p) => p.kind === 'backend').length },
  { id: 'fullstack', label: kindLabel.fullstack[locale], count: projects.filter((p) => p.kind === 'fullstack').length },
  { id: 'live', label: copy.live, count: projects.filter((p) => p.live).length },
];
---

<Base locale={locale} title={`${copy.title} | Gabriel Maciel`} description={copy.meta} alternate={route('projects', locale === 'pt' ? 'en' : 'pt')} current="projects">
  <div class="wrap page">
    <header class="page-head">
      <h1 class="page-title" data-reveal="title">{copy.title}</h1>
      <p class="lede" data-reveal="fade">{copy.intro}</p>
    </header>

    <div class="filters" role="group" aria-label={copy.filterLabel} data-filters hidden>
      {
        filters.map((f, i) => (
          <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label} <span class="count">{f.count}</span>
          </button>
        ))
      }
    </div>
    <p class="visually-hidden" role="status" data-filter-status></p>

    <ol class="list" data-project-list>
      {
        sorted.map((p) => (
          <li class="row" data-kind={p.kind} data-live={String(p.live)} style={`view-transition-name: project-${p.slug}`}>
            <div class="row-text">
              <p class="meta">
                {p.live && <span class="live-dot" aria-hidden="true" />}
                <span>{p.live ? copy.live : kindLabel[p.kind][locale]}</span>
                <span aria-hidden="true">/</span>
                <time datetime={p.start}>{formatMonth(p.start, locale)}</time>
              </p>
              <h2>
                <a href={projectRoute(p.slug, locale)}>{p.name}</a>
              </h2>
              <p class="summary">{p.summary[locale]}</p>
              <ul class="tags">
                {p.stack.slice(0, 5).map((s) => (
                  <li>{s}</li>
                ))}
                {p.stack.length > 5 && <li>+{p.stack.length - 5}</li>}
              </ul>
            </div>
            <a class="row-media" href={projectRoute(p.slug, locale)} tabindex="-1" aria-hidden="true">
              <ProjectCover project={p} locale={locale} sizes="(min-width: 56rem) 30vw, 100vw" />
            </a>
          </li>
        ))
      }
    </ol>
    <p class="empty" data-empty hidden>{copy.empty}</p>
  </div>
</Base>

<script>
  const group = document.querySelector<HTMLElement>('[data-filters]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-project-list] > li')];
  const status = document.querySelector<HTMLElement>('[data-filter-status]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  if (group) {
    // Sem JS a lista aparece inteira e os filtros ficam escondidos.
    group.hidden = false;
    const lang = document.documentElement.lang;
    const label = (n: number) =>
      lang.startsWith('pt') ? (n === 1 ? '1 projeto' : `${n} projetos`) : n === 1 ? '1 project' : `${n} projects`;

    const apply = (filter: string) => {
      let shown = 0;
      rows.forEach((row) => {
        const match =
          filter === 'all' || row.dataset.kind === filter || (filter === 'live' && row.dataset.live === 'true');
        row.hidden = !match;
        if (match) shown++;
      });
      group.querySelectorAll<HTMLButtonElement>('button').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.filter === filter)),
      );
      if (empty) empty.hidden = shown > 0;
      if (status) status.textContent = label(shown);
    };

    group.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
      if (!button) return;
      const filter = button.dataset.filter!;
      const run = () => apply(filter);
      // Com transição de visualização, as linhas deslizam para o lugar novo.
      if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.startViewTransition(run);
      } else run();
    });
  }
</script>

<style>
  .page {
    padding-top: clamp(2rem, 1rem + 4vw, 5rem);
  }

  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
  }

  .page-title {
    font-size: clamp(3.4rem, 1rem + 9vw, 8.5rem);
    font-stretch: 75%;
    font-weight: 780;
    letter-spacing: -0.035em;
    line-height: 0.86;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .filters button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    font-weight: 600;
    cursor: pointer;
  }

  .filters button:hover {
    border-color: var(--line-strong);
  }

  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .count {
    font-weight: 400;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }

  .list {
    margin-top: 2rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.5rem 3rem;
    align-items: center;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--line);
    view-transition-class: project-row;
  }

  .row[hidden] {
    display: none;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .row h2 {
    margin: 0.4rem 0 0.75rem;
    font-size: var(--step-4);
    font-stretch: 78%;
    letter-spacing: -0.025em;
  }

  .row h2 a {
    text-decoration: none;
  }

  .row h2 a::after {
    content: '';
    display: inline-block;
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.25em;
    border-radius: 50%;
    background: var(--signal);
    vertical-align: 0.5em;
    scale: 0;
    transition: scale 0.25s var(--ease-out);
  }

  .row:has(a:hover) h2 a::after,
  .row h2 a:focus-visible::after {
    scale: 1;
  }

  .summary {
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .row .tags {
    margin-top: 1.1rem;
  }

  .row-media {
    display: block;
    max-height: 18rem;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .row-media :global(.cover-phone) {
    height: 18rem;
  }

  .empty {
    margin-top: 2rem;
    color: var(--ink-soft);
  }

  ::view-transition-group(*.project-row) {
    animation-duration: 0.35s;
  }

  @media (max-width: 56rem) {
    .page-head,
    .row {
      grid-template-columns: 1fr;
    }
    .row-media {
      order: -1;
    }
  }
</style>
