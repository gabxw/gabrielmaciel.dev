---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StackPlayground from '../components/StackPlayground.astro';
import ProjectCover from '../components/ProjectCover.astro';
import Contact from '../components/Contact.astro';
import BookList from '../components/BookList.astro';
import { projects, kindLabel } from '../data/projects';
import { books } from '../data/books';
import { jobs, studies } from '../data/profile';
import { formatMonth, projectRoute, route, ui, type Locale } from '../i18n/ui';
import AsciiPortrait from '../components/AsciiPortrait.astro';
import ProjectStats from '../components/ProjectStats.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];

const copy = {
  pt: {
    title: 'Gabriel Maciel, desenvolvedor backend',
    description: 'Desenvolvedor backend em Belo Horizonte. C#/.NET, Laravel e Python. Projetos, trajetória e livros.',
    aboutTitle: 'Sobre mim',
    about: [
      'Sou Gabriel Maciel, desenvolvedor de software e estudante de Engenharia de Software, de Belo Horizonte, MG.',
      'Comecei a estudar programação em 2023, enquanto cursava o 2º ano do ensino médio. Hoje participo de todas as etapas do ciclo: definição da solução, modelagem da regra de negócio, implementação, infraestrutura, deploy e sustentação em produção.',
      'Atuo na construção de sistemas, APIs, integrações e automações, com maior foco em backend. Trabalho com tecnologias como C#, PHP, Laravel, Python e PostgreSQL, participando do desenvolvimento de soluções utilizadas em ambientes reais de produção.',
      'Sou praticante ativo de AI-Assisted Development. Cursor, Claude Code, Codex e Trae fazem parte do meu fluxo diário, e engenharia de contexto é o que me permite entregar rápido sem abrir mão de arquitetura e qualidade.',
      'Minha curiosidade vai além do código. Gosto de entender como as coisas funcionam, explorar novas tecnologias e transformar ideias em projetos. Tenho interesse por empreendedorismo, economia, literatura, música e novas experiências.',
      'Fora das telas, provavelmente estou planejando minha próxima viagem.',
    ],
    facts: [
      ['Base', 'Belo Horizonte, MG'],
      ['Agora', 'Desenvolvedor no Grupo Roma Brasil'],
      ['Estudando', 'Engenharia de Software na UFBRA'],
      ['Fora do código', 'Economia, literatura, música e viagens'],
    ],
    pathTitle: 'Trajetória',
    present: 'hoje',
    studyTitle: 'Formação',
    projectsTitle: 'Projetos',
    projectsText: 'Os que eu mais gosto de mostrar. Cada um tem uma página contando por que eu fiz e como funciona por dentro.',
    allProjects: `Ver os ${projects.length} projetos`,
    live: 'No ar',
    booksTitle: 'Lendo',
    allBooks: 'Ver a estante',
  },
  en: {
    title: 'Gabriel Maciel, backend developer',
    description: 'Backend developer in Belo Horizonte, Brazil. C#/.NET, Laravel and Python. Projects, career and books.',
    aboutTitle: 'About me',
    about: [
      "I'm Gabriel Maciel, a software developer and Software Engineering student from Belo Horizonte, Brazil.",
      'I started studying programming in 2023, while in my second year of high school. Today I take part in every stage of the cycle: defining the solution, modelling the business rules, implementation, infrastructure, deployment and keeping things running in production.',
      'I build systems, APIs, integrations and automations, with a stronger focus on backend. I work with technologies like C#, PHP, Laravel, Python and PostgreSQL, helping build solutions that run in real production environments.',
      'I am an active practitioner of AI-Assisted Development. Cursor, Claude Code, Codex and Trae are part of my daily workflow, and context engineering is what lets me ship fast without giving up architecture and quality.',
      'My curiosity goes beyond code. I like understanding how things work, exploring new technologies and turning ideas into projects. I am interested in entrepreneurship, economics, literature, music and new experiences.',
      "Away from screens, I'm probably planning my next trip.",
    ],
    facts: [
      ['Based in', 'Belo Horizonte, Brazil'],
      ['Now', 'Developer at Grupo Roma Brasil'],
      ['Studying', 'Software Engineering at UFBRA'],
      ['Off the clock', 'Economics, literature, music and travel'],
    ],
    pathTitle: 'Career',
    present: 'now',
    studyTitle: 'Education',
    projectsTitle: 'Projects',
    projectsText: 'The ones I most like to show. Each has a page explaining why I built it and how it works inside.',
    allProjects: `See all ${projects.length} projects`,
    live: 'Live',
    booksTitle: 'Reading',
    allBooks: 'See the shelf',
  },
}[locale];

const featured = projects.filter((p) => p.featured);
const [lead, ...others] = featured;
const range = (start: string, end?: string) => `${formatMonth(start, locale)} – ${end ? formatMonth(end, locale) : copy.present}`;
---

<Base locale={locale} title={copy.title} description={copy.description} alternate={route('home', locale === 'pt' ? 'en' : 'pt')} current="home">
  <Hero locale={locale} />

  <section class="about wrap" aria-labelledby="about-title">
    <div class="about-photo">
      <AsciiPortrait locale={locale} />
    </div>
    <div class="about-text">
      <h2 id="about-title" class="section-title" data-reveal="title">{copy.aboutTitle}</h2>
      <div class="prose" data-reveal="fade">
        {copy.about.map((p) => <p>{p}</p>)}
      </div>
      <dl class="facts" data-reveal="stagger">
        {
          copy.facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="path wrap" aria-labelledby="path-title">
    <h2 id="path-title" class="section-title" data-reveal="title">{copy.pathTitle}</h2>
    <div class="timeline">
      <span class="timeline-rail" aria-hidden="true"><span class="timeline-progress" data-timeline-progress></span></span>
      <ol class="jobs">
      {
        jobs.map((job) => (
          <li class="job" data-reveal="fade">
            <div class="job-head">
              <h3>{job.company}</h3>
              <p>{job.place[locale]}</p>
            </div>
            <ol class="roles">
              {job.roles.map((role) => (
                <li class:list={['role', { current: !role.end }]}>
                  <span class="dot" aria-hidden="true" />
                  <p class="when">
                    <time datetime={role.start}>{range(role.start, role.end)}</time>
                  </p>
                  <h4>
                    {role.title[locale]} <span class="kind">{role.kind[locale]}</span>
                  </h4>
                  <ul class="role-items">
                    {role.items.map((item) => (
                      <li>{item[locale]}</li>
                    ))}
                  </ul>
                  {role.stack && (
                    <ul class="tags">
                      {role.stack.map((s) => (
                        <li>{s}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </li>
        ))
      }
      </ol>
    </div>

    <div class="studies" data-reveal="fade">
      <h3>{copy.studyTitle}</h3>
      <ul>
        {
          studies.map((s) => (
            <li>
              <strong>{s.course[locale]}</strong>
              <span>
                {s.school}, {range(s.start, s.end)}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="work wrap" aria-labelledby="work-title">
    <div class="work-head">
      <h2 id="work-title" class="section-title" data-reveal="title">{copy.projectsTitle}</h2>
      <p class="lede" data-reveal="fade">{copy.projectsText}</p>
    </div>

    <article class="lead-project">
      <a class="lead-media" href={projectRoute(lead.slug, locale)} tabindex="-1" aria-hidden="true" data-reveal="clip">
        <ProjectCover project={lead} locale={locale} />
      </a>
      <div class="lead-text" data-reveal="fade">
        <p class="meta">{kindLabel[lead.kind][locale]}, {formatMonth(lead.start, locale)}</p>
        <h3><a href={projectRoute(lead.slug, locale)}>{lead.name}</a></h3>
        <p>{lead.summary[locale]}</p>
        {lead.stats && (
          <div class="lead-stats">
            <ProjectStats stats={lead.stats} locale={locale} compact />
          </div>
        )}
        <ul class="tags">{lead.stack.slice(0, 6).map((s) => <li>{s}</li>)}</ul>
        <a class="btn" href={projectRoute(lead.slug, locale)}>{t.viewProject}<span class="visually-hidden">: {lead.name}</span></a>
      </div>
    </article>

    <div class="pair">
      {
        others.map((p) => (
          <article class="project-card" data-reveal="fade">
            <a class="card-media" href={projectRoute(p.slug, locale)} tabindex="-1" aria-hidden="true">
              <ProjectCover project={p} locale={locale} sizes="(min-width: 56rem) 40vw, 100vw" />
            </a>
            <p class="meta">
              {p.live && <span class="live-dot" aria-hidden="true" />}
              {p.live ? copy.live : kindLabel[p.kind][locale]}, {formatMonth(p.start, locale)}
            </p>
            <h3><a href={projectRoute(p.slug, locale)}>{p.name}</a></h3>
            <p>{p.summary[locale]}</p>
          </article>
        ))
      }
    </div>

    <a class="all-link" href={route('projects', locale)}>{copy.allProjects}</a>
  </section>

  <StackPlayground locale={locale} />

  {
    books.length > 0 && (
      <section class="reading wrap" aria-labelledby="reading-title">
        <h2 id="reading-title" class="section-title" data-reveal="title">{copy.booksTitle}</h2>
        <BookList books={books.filter((b) => b.status === 'reading').slice(0, 3)} locale={locale} />
        <a class="all-link" href={route('books', locale)}>{copy.allBooks}</a>
      </section>
    )
  }

  <Contact locale={locale} />
</Base>

<style>
  .about {
    margin-top: var(--section);
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: 2.5rem 4rem;
    align-items: start;
  }

  .about-photo {
    max-width: 26rem;
  }

  .prose {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
    max-width: var(--measure);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    max-width: var(--measure);
  }

  .facts dt {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .facts dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }

  /* Trajetória */
  .path {
    margin-top: var(--section);
  }

  .timeline {
    position: relative;
    margin-top: 3rem;
  }

  .jobs {
    display: grid;
    gap: 3.5rem;
    padding: 0;
    list-style: none;
  }

  .timeline-rail {
    position: absolute;
    top: 0.4rem;
    bottom: 0;
    left: calc(25% + 1.25rem);
    width: 2px;
    background: var(--line);
  }

  .timeline-progress {
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform-origin: top;
  }

  .job {
    display: grid;
    grid-template-columns: 25% minmax(0, 1fr);
    gap: 1rem 2.5rem;
  }

  .job-head h3 {
    font-size: var(--step-2);
    font-stretch: 85%;
    letter-spacing: -0.01em;
  }

  .job-head p {
    color: var(--ink-soft);
    margin-top: 0.3rem;
  }

  .roles {
    display: grid;
    gap: 2.25rem;
    padding: 0;
    list-style: none;
  }

  .role {
    position: relative;
    padding-left: 1.5rem;
    max-width: var(--measure);
  }

  .dot {
    position: absolute;
    left: calc(-1.25rem - 6px);
    top: 0.45rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line-strong);
  }

  .role.current .dot {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 0 5px var(--signal-wash);
  }

  .when {
    color: var(--ink-soft);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .role h4 {
    margin-top: 0.25rem;
    font-size: var(--step-1);
    font-weight: 650;
  }

  .kind {
    font-weight: 400;
    color: var(--ink-soft);
    font-size: var(--step-0);
    margin-left: 0.25rem;
  }

  .role-items {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.75rem;
    padding-left: 1.1rem;
  }

  .role-items li::marker {
    color: var(--signal-text);
  }

  .role .tags {
    margin-top: 0.9rem;
  }

  .studies {
    display: grid;
    grid-template-columns: 25% minmax(0, 1fr);
    gap: 1rem 2.5rem;
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .studies h3 {
    font-size: var(--step-2);
    font-stretch: 85%;
  }

  .studies ul {
    display: grid;
    gap: 1rem;
    padding: 0 0 0 1.5rem;
    list-style: none;
  }

  .studies li {
    display: grid;
  }

  .studies span {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  /* Projetos */
  .work {
    margin-top: var(--section);
  }

  .work-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem 3rem;
    align-items: end;
  }

  .lead-project {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: center;
    margin-top: 3rem;
  }

  .lead-stats {
    margin-top: 1.5rem;
  }

  .lead-text h3 {
    font-size: var(--step-4);
    font-stretch: 78%;
    letter-spacing: -0.025em;
    margin: 0.4rem 0 1rem;
  }

  .lead-text h3 a,
  .project-card h3 a {
    text-decoration: none;
  }

  .lead-text h3 a:hover,
  .project-card h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }

  .lead-text > p:not(.meta) {
    color: var(--ink-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .lead-text .tags {
    margin: 1.25rem 0 1.5rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2.5rem;
    margin-top: 4rem;
  }

  .project-card .card-media {
    display: block;
    margin-bottom: 1.1rem;
  }

  .project-card .card-media :global(.cover-phone) {
    height: 22rem;
  }

  .project-card h3 {
    font-size: var(--step-3);
    font-stretch: 82%;
    letter-spacing: -0.015em;
    margin: 0.3rem 0 0.5rem;
  }

  .project-card > p:last-child {
    color: var(--ink-soft);
    max-width: 52ch;
  }

  .card-media,
  .lead-media {
    transition: translate 0.4s var(--ease-out);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .project-card:has(h3 a:hover) .card-media,
    .lead-project:has(h3 a:hover) .lead-media {
      translate: 0 -6px;
    }
  }

  .all-link {
    display: inline-block;
    margin-top: 3rem;
    font-size: var(--step-1);
    font-weight: 600;
  }

  .reading {
    margin-top: var(--section);
  }

  .reading :global(.books) {
    margin-top: 2.5rem;
    max-width: 52rem;
  }

  @media (max-width: 56rem) {
    .about,
    .work-head,
    .lead-project,
    .pair {
      grid-template-columns: 1fr;
    }
    .about-photo {
      max-width: 24rem;
    }
    .facts {
      grid-template-columns: 1fr;
    }
    .timeline-rail {
      left: 0;
    }
    .job,
    .studies {
      grid-template-columns: 1fr;
    }
    .job-head,
    .studies h3 {
      padding-left: 1.5rem;
    }
    .dot {
      left: -6px;
    }
  }
</style>
